{
  "name": "utbt-launcher",
  "version": "1.17.1",
  "description": "UTBT.net Launcher",
  "main": "./out/main/main.js",
  "license": "MIT",
  "author": {
    "name": "UTBT.net",
    "url": "https://utbt.net"
  },
  "scripts": {
    "predev": "node scripts/ensure-electron.mjs",
    "dev": "cross-env ELECTRON_DISABLE_SANDBOX=1 electron-vite dev -w",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "electron-vite preview",
    "test": "vitest run",
    "postinstall": "electron-builder install-app-deps",
    "vite:build:app": "electron-vite build",
    "electron:build:win": "electron-builder --win --publish never",
    "build:win": "run-s vite:build:app electron:build:win",
    "dev:web": "vite --config vite.config.web.ts",
    "build:web": "vite build --config vite.config.web.ts",
    "preview:web": "vite preview --config vite.config.web.ts",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "test:e2e": "playwright test",
    "test:e2e:live": "cross-env UTBT_LIVE_API=1 playwright test --grep @live",
    "check:bundle": "node scripts/check-web-bundle.mjs",
    "quality:web": "npm-run-all typecheck:web lint test build:web check:bundle"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/UT-BT/launcher"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.0",
    "@types/ini": "^4.1.1",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "ini": "^6.0.0",
    "lucide-react": "^0.541.0",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zip-lib": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tailwindcss/vite": "^4.3.1",
    "@types/chokidar": "^2.1.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "baseline-browser-mapping": "^2.10.37",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "framer-motion": "^12.40.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
