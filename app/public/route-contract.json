{
  "version": 2,
  "routes": [
    { "path": "/", "view": "home", "kind": "home" },
    { "path": "/servers", "view": "servers", "kind": "list.servers" },
    { "path": "/maps", "view": "maps", "kind": "list.maps" },
    { "path": "/maps/:mapName", "view": "maps-detail", "kind": "map", "params": ["mapName"] },
    { "path": "/players", "view": "players", "kind": "list.players" },
    { "path": "/players/:playerId", "view": "player-detail", "kind": "player", "params": ["playerId"] },
    { "path": "/teams", "view": "teams", "kind": "list.teams" },
    { "path": "/teams/:teamId", "view": "team-detail", "kind": "team", "params": ["teamId"] },
    { "path": "/events", "view": "events", "kind": "list.events" },
    { "path": "/events/:eventSlug", "view": "event-detail", "kind": "event", "params": ["eventSlug"] },
    { "path": "/events/:eventSlug/matches/:matchId", "view": "match-pickban", "kind": "match-pickban", "params": ["eventSlug", "matchId"] },
    { "path": "/world-records", "view": "world-records", "kind": "list.world-records" },
    { "path": "/cap-it-all", "view": "cap-it-all", "kind": "list.cap-it-all" },
    { "path": "/caps/:capId", "view": "cap-detail", "kind": "cap", "params": ["capId"] },
    { "path": "/team-caps/:teamCapId", "view": "team-cap-detail", "kind": "team-cap", "params": ["teamCapId"] },
    { "path": "/achievements", "view": "achievements", "kind": "list.achievements" },
    { "path": "/news", "view": "news", "kind": "list.news" },
    { "path": "/news/:newsId", "view": "news-detail", "kind": "news", "params": ["newsId"] },
    { "path": "/admin", "view": "admin", "kind": "admin" }
  ]
}
