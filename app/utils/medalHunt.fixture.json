{
  "version": 1,
  "description": "Golden fixture for the medal-hunt rule port. Recorded against the pre-endpoint client implementation. Thresholds and difficulty use the semantic token \"absent\" rather than a wire literal: the API emits \"\" for an absent float/int (base.py:39 casts through the dataclass field type, float(None)/int(None) raise TypeError, caught at base.py:45-46), while the Python port sees None. Each suite maps \"absent\" to its own native representation.",
  "cases": [
    {
      "name": "certified cap above bronze targets Bronze",
      "caps": [{ "map": "CTF-Simple", "cap_time_seconds": 100.0, "cap_type": 2, "verified": true }],
      "maps": [
        {
          "name": "CTF-Simple",
          "difficulty": 3,
          "required_players": 1,
          "bronze_medal": 80.0,
          "silver_medal": 65.0,
          "gold_medal": 56.25,
          "champion_medal": 51.25,
          "world_record": 50.0
        }
      ],
      "worldRecordDates": { "CTF-Simple": "2026-01-02 03:04:05.123456" },
      "expected": [
        {
          "mapName": "CTF-Simple",
          "difficulty": 3,
          "currentTime": 100.0,
          "targetTime": 80.0,
          "targetMedal": "Bronze Medal",
          "improvement": 20.0,
          "improvementPct": 0.2,
          "worldRecordAdded": "2026-01-02 03:04:05.123456"
        }
      ]
    },
